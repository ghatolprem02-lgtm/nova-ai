
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#09090b">
  <title>NOVA AI — Your AI Workspace</title>
  <meta name="description" content="Welcome to NOVA AI, your all-in-one AI workspace.">
  <style>
    :root {
      color-scheme: dark;
      --bg: #09090b;
      --panel: #111114;
      --panel2: #18181d;
      --border: #28282f;
      --text: #f5f5f7;
      --muted: #92929e;
      --accent: #a78bfa;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system,
        BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    button, textarea { font: inherit; }
    button { cursor: pointer; }

    .app { min-height: 100vh; display: flex; }

    .sidebar {
      width: 250px;
      flex-shrink: 0;
      padding: 22px 15px;
      background: #0d0d10;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 25px;
    }

    .brand { display: flex; align-items: center; gap: 11px; padding: 0 8px; }

    .logo {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      color: white;
      font-size: 23px;
      font-weight: 800;
      background: linear-gradient(135deg, #a78bfa, #6366f1 65%, #27215b);
      box-shadow: 0 0 24px #8b5cf633;
    }

    .brand-name { font-size: 20px; font-weight: 750; letter-spacing: 1.5px; }
    .brand-sub { color: var(--muted); font-size: 11px; margin-top: 3px; }

    .new-chat {
      width: 100%;
      padding: 12px;
      border: 1px solid #51416f;
      border-radius: 11px;
      color: white;
      background: #241b35;
      text-align: left;
    }

    .nav-label {
      margin: 0 10px 9px;
      color: #777783;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.7px;
    }

    .nav { display: grid; gap: 5px; }

    .nav button {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 11px 12px;
      color: #aaaab6;
      border: 1px solid transparent;
      border-radius: 10px;
      background: transparent;
      text-align: left;
      transition: .2s;
    }

    .nav button:hover, .nav button.active {
      color: white;
      background: var(--panel2);
      border-color: var(--border);
    }

    .nav-icon { width: 21px; text-align: center; font-size: 17px; }

    .sidebar-bottom {
      margin-top: auto;
      padding: 13px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--panel);
    }

    .sidebar-bottom strong { font-size: 12px; }
    .sidebar-bottom p { color: var(--muted); font-size: 11px; line-height: 1.6; margin-bottom: 0; }

    .main { flex: 1; min-width: 0; display: flex; flex-direction: column; }

    .topbar {
      min-height: 69px;
      padding: 15px 26px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .page-title { font-size: 14px; font-weight: 650; }
    .status { color: #a7a7b3; font-size: 12px; }
    .status span { color: #a78bfa; }

    .menu-btn {
      display: none;
      color: white;
      background: var(--panel2);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 8px 11px;
    }

    .content {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      padding: 48px 26px 28px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .welcome { text-align: center; margin: 15px 0 30px; }

    .eyebrow {
      display: inline-block;
      color: #c4b5fd;
      border: 1px solid #51416f;
      background: #1d1730;
      border-radius: 99px;
      padding: 7px 12px;
      font-size: 11px;
      letter-spacing: .6px;
    }

    h1 {
      margin: 20px 0 12px;
      font-size: clamp(32px, 5vw, 51px);
      letter-spacing: -2px;
      line-height: 1.1;
    }

    .gradient {
      background: linear-gradient(90deg, #c4b5fd, #818cf8, #f0abfc);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .subtitle {
      max-width: 490px;
      margin: 0 auto;
      color: var(--muted);
      line-height: 1.8;
      font-size: 14px;
    }

    .messages { display: grid; gap: 14px; margin-bottom: 22px; }

    .message {
      max-width: 82%;
      padding: 13px 16px;
      border: 1px solid var(--border);
      border-radius: 15px;
      background: var(--panel);
      font-size: 14px;
      line-height: 1.7;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }

    .message.user {
      justify-self: end;
      background: #241b35;
      border-color: #51416f;
    }

    .message.assistant { justify-self: start; }

    .suggestions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin: 0 0 24px;
    }

    .suggestion {
      min-height: 94px;
      padding: 16px;
      text-align: left;
      color: var(--text);
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 13px;
      transition: .2s;
    }

    .suggestion:hover {
      border-color: #74609b;
      transform: translateY(-2px);
      background: #17151e;
    }

    .suggestion .symbol { font-size: 21px; margin-bottom: 10px; }
    .suggestion strong { display: block; font-size: 13px; margin-bottom: 5px; }
    .suggestion small { color: var(--muted); font-size: 11px; line-height: 1.5; }

    .composer {
      margin-top: auto;
      padding: 12px;
      border: 1px solid #38333f;
      border-radius: 17px;
      background: #121215;
      box-shadow: 0 12px 45px #0004;
    }

    .composer textarea {
      display: block;
      width: 100%;
      min-height: 54px;
      max-height: 180px;
      padding: 10px;
      resize: vertical;
      color: white;
      background: transparent;
      border: 0;
      outline: 0;
      font-size: 14px;
      line-height: 1.6;
    }

    .composer textarea::placeholder { color: #747480; }

    .composer-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 7px 3px 0;
    }

    .composer-hint { color: #777783; font-size: 11px; }

    .send {
      padding: 10px 16px;
      color: white;
      background: linear-gradient(135deg, #8b5cf6, #6366f1);
      border: 0;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 700;
    }

    .send:hover { filter: brightness(1.12); }

    .footer {
      padding: 16px 0 0;
      color: #666672;
      text-align: center;
      font-size: 10px;
      line-height: 1.7;
    }

    .toast {
      display: none;
      margin-bottom: 14px;
      padding: 12px;
      color: #d6caff;
      border: 1px solid #51416f;
      background: #1d1730;
      border-radius: 10px;
      font-size: 12px;
      line-height: 1.6;
    }

    @media (max-width: 760px) {
      .sidebar {
        position: fixed;
        z-index: 5;
        inset: 0 auto 0 0;
        width: 260px;
        transform: translateX(-105%);
        transition: transform .22s ease;
        box-shadow: 15px 0 40px #0008;
      }

      .sidebar.open { transform: translateX(0); }
      .menu-btn { display: inline-block; }
      .topbar { padding: 13px 16px; }
      .content { padding: 28px 16px 20px; }
      .welcome { margin-top: 22px; }
      h1 { letter-spacing: -1.3px; }
      .message { max-width: 95%; }
    }

    @media (max-width: 420px) {
      .suggestions { grid-template-columns: 1fr; }
      .suggestion { min-height: 76px; }
      .status { font-size: 10px; }
      .composer-hint { max-width: 155px; }
    }
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <div class="logo">N</div>
        <div>
          <div class="brand-name">NOVA AI</div>
          <div class="brand-sub">YOUR CREATIVE UNIVERSE</div>
        </div>
      </div>

      <button class="new-chat" id="newChat">＋ &nbsp; New conversation</button>

      <div>
        <p class="nav-label">WORKSPACE</p>
        <nav class="nav" aria-label="AI tools">
          <button class="active" data-tool="Chat"><span class="nav-icon">✳</span> AI Chat</button>
          <button data-tool="Image"><span class="nav-icon">▧</span> Image Studio</button>
          <button data-tool="Video"><span class="nav-icon">▷</span> Video Studio</button>
          <button data-tool="Audio"><span class="nav-icon">♫</span> Audio Studio</button>
          <button data-tool="Code"><span class="nav-icon">⌘</span> Code Assistant</button>
        </nav>
      </div>

      <div class="sidebar-bottom">
        <strong>✦ NOVA AI</strong>
        <p>Your creative workspace, all in one place. More AI capabilities coming as we connect services.</p>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div style="display:flex;align-items:center;gap:12px">
          <button class="menu-btn" id="menuBtn" aria-label="Open menu">☰</button>
          <div class="page-title" id="pageTitle">✳ &nbsp; AI Chat</div>
        </div>
        <div class="status"><span>●</span> Website preview</div>
      </header>

      <section class="content">
        <div class="welcome" id="welcome">
          <span class="eyebrow">✦ &nbsp; YOUR AI WORKSPACE</span>
          <h1>Imagine more.<br><span class="gradient">Create with NOVA.</span></h1>
          <p class="subtitle">A home for your ideas, creativity, and productivity. What would you like to explore today?</p>
        </div>

        <div class="toast" id="toast" role="status"></div>
        <div class="messages" id="messages" aria-live="polite"></div>

        <div class="suggestions" id="suggestions">
          <button class="suggestion" data-prompt="Help me brainstorm a creative project.">
            <div class="symbol">✧</div>
            <strong>Brainstorm ideas</strong>
            <small>Explore new possibilities and creative concepts.</small>
          </button>
          <button class="suggestion" data-tool="Image">
            <div class="symbol">▧</div>
            <strong>Create an image</strong>
            <small>Explore the image studio interface.</small>
          </button>
          <button class="suggestion" data-tool="Video">
            <div class="symbol">▷</div>
            <strong>Make a video</strong>
            <small>Explore video creation tools.</small>
          </button>
          <button class="suggestion" data-tool="Code">
            <div class="symbol">⌘</div>
            <strong>Build something</strong>
            <small>Get started with a coding project.</small>
          </button>
        </div>

        <form class="composer" id="chatForm">
          <textarea id="prompt" rows="2" aria-label="Your message"
            placeholder="Message NOVA AI..."></textarea>
          <div class="composer-bottom">
            <span class="composer-hint">NOVA preview · Live AI not connected yet</span>
            <button class="send" type="submit">Send ↑</button>
          </div>
        </form>

        <footer class="footer">
          NOVA AI · An independent project, not affiliated with Google.<br>
          AI features will become available as supported services are connected.
        </footer>
      </section>
    </main>
  </div>

  <script>
    const sidebar = document.getElementById("sidebar");
    const pageTitle = document.getElementById("pageTitle");
    const welcome = document.getElementById("welcome");
    const messages = document.getElementById("messages");
    const suggestions = document.getElementById("suggestions");
    const prompt = document.getElementById("prompt");
    const toast = document.getElementById("toast");

    const icons = {
      Chat: "✳",
      Image: "▧",
      Video: "▷",
      Audio: "♫",
      Code: "⌘"
    };

    const descriptions = {
      Chat: "Ask questions, explore ideas, and work through problems.",
      Image: "Describe an image you would like to create or edit.",
      Video: "Plan a video scene or explore a creative video idea.",
      Audio: "Explore voice, sound, and music ideas.",
      Code: "Describe a website, app, or coding problem."
    };

    function showToast(text) {
      toast.textContent = text;
      toast.style.display = "block";
    }

    function chooseTool(tool) {
      pageTitle.textContent = icons[tool] + "   " +
        ({Chat:"AI Chat", Image:"Image Studio", Video:"Video Studio",
          Audio:"Audio Studio", Code:"Code Assistant"}[tool]);
      document.querySelectorAll(".nav button").forEach(button => {
        button.classList.toggle("active", button.dataset.tool === tool);
      });

      welcome.querySelector("h1").innerHTML =
        tool === "Chat"
          ? 'Imagine more.<br><span class="gradient">Create with NOVA.</span>'
          : '<span class="gradient">NOVA ' + tool + '</span><br>Make your ideas real.';
      welcome.querySelector(".subtitle").textContent = descriptions[tool];
      prompt.placeholder = tool === "Chat"
        ? "Message NOVA AI..."
        : "Describe what you want to " + tool.toLowerCase() + "...";

      showToast(tool === "Chat"
        ? "Chat interface selected. A real AI model has not been connected yet."
        : tool + " Studio selected. This interface is ready for a compatible AI service to be connected.");

      sidebar.classList.remove("open");
    }

    document.querySelectorAll("[data-tool]").forEach(button => {
      button.addEventListener("click", () => chooseTool(button.dataset.tool));
    });

    document.getElementById("menuBtn").addEventListener("click", () => {
      sidebar.classList.toggle("open");
    });

    document.getElementById("newChat").addEventListener("click", () => {
      messages.replaceChildren();
      welcome.style.display = "";
      suggestions.style.display = "";
      toast.style.display = "none";
      prompt.value = "";
      chooseTool("Chat");
    });

    document.querySelectorAll("[data-prompt]").forEach(button => {
      button.addEventListener("click", () => {
        prompt.value = button.dataset.prompt;
        prompt.focus();
      });
    });

    document.getElementById("chatForm").addEventListener("submit", event => {
      event.preventDefault();
      const text = prompt.value.trim();
      if (!text) {
        prompt.focus();
        return;
      }

      welcome.style.display = "none";
      suggestions.style.display = "none";

      const userMessage = document.createElement("div");
      userMessage.className = "message user";
      userMessage.textContent = text;
      messages.appendChild(userMessage);

      const reply = document.createElement("div");
      reply.className = "message assistant";
      reply.textContent =
        "Your message is displayed successfully! NOVA AI is currently a website prototype, so it cannot generate a real AI answer yet. In our next step, we'll work on connecting a hosted AI model.";
      messages.appendChild(reply);

      prompt.value = "";
      messages.scrollIntoView({ behavior: "smooth", block: "end" });
    });
  </script>
</body>
</html>
